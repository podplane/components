{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "apps": {
                    "properties": {
                      "podplane-operator": {
                        "properties": {
                          "enabled": {
                            "const": true
                          }
                        },
                        "required": ["enabled"]
                      }
                    },
                    "required": ["podplane-operator"]
                  }
                },
                "required": ["apps"]
              },
              "then": {
                "properties": {
                  "clusterID": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["clusterID"]
              }
            }
          ],
          "properties": {
            "reconcileInterval": {
              "type": "string",
              "minLength": 1
            },
            "registry": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mirror": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "hostname": {
                      "type": "string"
                    }
                  },
                  "required": ["enabled", "hostname"]
                }
              },
              "required": ["mirror"]
            },
            "clusterID": {
              "type": "string"
            },
            "secrets": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "allowSyncToKubernetesSecrets": {
                  "type": "boolean"
                },
                "providers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": ["aws", "gcp", "vault", "openbao"]
                      },
                      "keyPrefix": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "crds": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/componentEntry"
              }
            },
            "apps": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/componentEntry"
              }
            },
            "values": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": ["reconcileInterval", "registry", "secrets", "crds", "apps", "values"]
        }
      },
      "required": ["components"]
    }
  },
  "required": ["platform"],
  "definitions": {
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "manageNamespace": {
          "type": "boolean"
        },
        "core": {
          "type": "boolean",
          "description": "When true, the Podplane CLI treats this component as core and will refuse to uninstall it."
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["enabled"]
    }
  }
}
