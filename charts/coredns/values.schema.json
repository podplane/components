{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "properties": {
        "coredns": {
          "type": "object",
          "properties": {
            "staticRecords": {
              "type": "object",
              "description": "Hostnames mapped to IPv4/IPv6 address lists, served as A/AAAA and automatic PTR records.",
              "propertyNames": {
                "format": "hostname"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "anyOf": [
                    { "format": "ipv4" },
                    { "format": "ipv6" }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
